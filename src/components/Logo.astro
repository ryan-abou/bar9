---
import { SITE, url } from '../site';

const i = SITE.name.lastIndexOf(SITE.circled);
// The gap before the circled part comes from CSS, so the pencil circle has room.
const before = i >= 0 ? SITE.name.slice(0, i).trimEnd() : SITE.name;
const circled = i >= 0 ? SITE.circled : '';
const after = i >= 0 ? SITE.name.slice(i + SITE.circled.length) : '';
---
<a class="logo" href={url('/')} aria-label={`${SITE.name}, home`}>
  {before}{circled && (
    <span class="circled">{circled}<svg aria-hidden="true" viewBox="0 0 48 52" fill="none" stroke="#B33A26" stroke-width="1.8" stroke-linecap="round"><path d="M31 5 C13 2 2 15 4 29 C6 45 25 51 37 44 C49 37 47 13 32 6 C27 4 21 5 16 9" /></svg></span>
  )}{after}
</a>
