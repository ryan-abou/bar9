---
// A loose red pencil loop around a short piece of text, like a teacher marking a bar.
---
<span class="circled"><slot /><svg aria-hidden="true" viewBox="0 0 48 52" fill="none" stroke="var(--pencil)" stroke-width="1.8" stroke-linecap="round"><path class="pencil-loop" pathLength="1" d="M31 5 C13 2 2 15 4 29 C6 45 25 51 37 44 C49 37 47 13 32 6 C27 4 21 5 16 9" /></svg></span>

<style>
  .circled { position: relative; display: inline-block; padding: 0 0.2em; }
  svg { position: absolute; left: 50%; top: 50%; width: 2em; height: 2.1em; transform: translate(-50%, -52%); overflow: visible; pointer-events: none; }
</style>
