---
// Section divider: a short piece of staff ending in a final double barline.
---
<div class="barline" aria-hidden="true">
  <svg viewBox="0 0 120 26" width="120" height="26" fill="none">
    <g stroke="var(--staff)" stroke-width="1">
      <path d="M0 1h112M0 7h112M0 13h112M0 19h112M0 25h112" />
    </g>
    <path d="M106 1v24" stroke="var(--ink)" stroke-width="1.2" />
    <path d="M112 1v24" stroke="var(--ink)" stroke-width="3.5" />
  </svg>
</div>

<style>
  .barline { display: flex; justify-content: center; padding: 8px 0; }
</style>
