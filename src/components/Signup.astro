---
// Email signup, posted straight to Kit. Works without JavaScript (Kit shows its own page);
// with JavaScript it stays on the page and answers inline.
import { SITE } from '../site';

interface Props {
  heading?: string;
  text?: string;
  id?: string;
}
const {
  heading = 'Get each issue by email',
  text = 'One email on the 9th of each month, when a new issue is out. Nothing else.',
  id = 'subscribe',
} = Astro.props;
---
<section class="signup" id={id} aria-labelledby={`${id}-h`}>
  <h2 id={`${id}-h`}>{heading}</h2>
  <p class="lede">{text}</p>
  <form class="signup-form" action={SITE.newsletter.action} method="post" novalidate>
    <label class="sr" for={`${id}-email`}>Email address</label>
    <input class="t-input" id={`${id}-email`} type="email" name="email_address" placeholder="you@example.com" autocomplete="email" required />
    <button type="submit">Sign up</button>
  </form>
  <p class="status" role="status" aria-live="polite"><span class="t-text-swap"></span></p>
  <p class="fine">You'll get one email to confirm first. Every email has an unsubscribe link.</p>
</section>

<script>
  // transitions.dev "text states swap": the old words leave upward with a little blur, the new ones rise in.
  function swapText(el: HTMLElement & { _swap?: number }, next: string) {
    if (el.textContent === next) return;
    clearTimeout(el._swap);
    el.classList.add('is-exit');
    el._swap = window.setTimeout(() => {
      el.textContent = next;
      el.classList.remove('is-exit');
      el.classList.add('is-enter-start');
      void el.offsetWidth;
      el.classList.remove('is-enter-start');
    }, 150);
  }
  // transitions.dev "error state shake" on the email field.
  function shake(el: HTMLElement) {
    el.classList.remove('is-shaking');
    void el.offsetWidth;
    el.classList.add('is-shaking');
  }

  document.querySelectorAll<HTMLFormElement>('.signup-form').forEach((form) => {
    const box = form.closest('.signup')!;
    const status = box.querySelector<HTMLElement>('.status .t-text-swap')!;
    const button = form.querySelector('button')!;
    const input = form.querySelector('input')!;
    const line = box.querySelector<HTMLElement>('.status')!;
    const say = (msg: string, state?: 'error' | 'done') => {
      box.classList.toggle('error', state === 'error');
      box.classList.toggle('done', state === 'done');
      input.setAttribute('aria-invalid', state === 'error' ? 'true' : 'false');
      swapText(status, msg);
    };
    // On a phone the keyboard covers the bottom of the page, where the message is. Once the keyboard is up,
    // scroll just enough to show the message above it.
    const reveal = () => {
      const vv = window.visualViewport;
      const nudge = () => {
        const r = line.getBoundingClientRect();
        const bottom = vv ? vv.offsetTop + vv.height : window.innerHeight;
        const over = r.bottom + 16 - bottom;
        if (over > 0) window.scrollBy(0, over);
      };
      // The keyboard slides up over a few hundred ms, so check on every resize while it does, and once more after.
      nudge();
      if (vv) {
        vv.addEventListener('resize', nudge);
        setTimeout(() => vv.removeEventListener('resize', nudge), 1500);
      }
      setTimeout(nudge, 900);
    };
    input.addEventListener('input', () => box.classList.remove('error'));
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = input.value.trim();
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        say("That doesn't look like an email address.", 'error');
        shake(input);
        input.focus();
        reveal();
        return;
      }
      button.disabled = true;
      say('Signing you up…');
      try {
        const res = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
        const data = await res.json().catch(() => ({}));
        if (res.ok && data.status === 'success') {
          say(`Almost done. Check ${email} and click the link in the email from Ryan to confirm.`, 'done');
          form.reset();
        } else {
          const msg = data.errors?.messages?.[0];
          say(msg ? `${msg}.`.replace(/\.\.$/, '.') : "Something went wrong. Try again in a minute.", 'error');
        }
      } catch {
        say("Couldn't reach the signup service. Check your connection and try again.", 'error');
      } finally {
        button.disabled = false;
      }
    });
  });
</script>

<style>
  .signup { padding: 28px 0 8px; border-top: 2px solid var(--ink); }
  h2 { margin: 0 0 6px; font-family: var(--display); font-weight: 400; font-size: 30px; line-height: 1.15; }
  .lede { margin: 0 0 18px; font-size: 18px; line-height: 1.55; color: var(--ink-2); max-width: 560px; }
  .signup-form { display: flex; flex-wrap: wrap; gap: 10px; max-width: 560px; }
  input {
    flex: 1 1 260px; min-width: 0; min-height: 48px; padding: 0 14px;
    font: inherit; font-size: 18px; color: var(--ink);
    background: #fbf9f4; border: 1px solid var(--staff); border-radius: 4px;
  }
  input::placeholder { color: #8f887c; }
  input:focus { outline: 2px solid var(--ink); outline-offset: 1px; border-color: var(--ink); }
  input { transition: border-color var(--duration-quick) ease-out; }
  .error input { border-color: var(--pencil); outline-color: var(--pencil); }
  button {
    min-height: 48px; padding: 0 22px; font: inherit; font-size: 18px;
    color: var(--paper); background: var(--ink); border: 0; border-radius: 4px; cursor: pointer;
  }
  button:hover { background: #000; }
  button:disabled { opacity: 0.6; cursor: wait; }
  .status { margin: 12px 0 0; min-height: 1.5em; font-size: 17px; font-style: italic; color: var(--ink-2); }
  .done .status { color: var(--ink); }
  .error .status { color: var(--pencil); }
  .fine { margin: 4px 0 0; font-size: 14px; color: var(--gray); }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
</style>
