---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PianoGlassPanel from '../../components/PianoGlassPanel.astro';
import Signup from '../../components/Signup.astro';
import { getIssues, readingTime, type Issue } from '../../lib/issues';
import { plan } from '../../data/plan';
import { url, formatDate } from '../../site';

export async function getStaticPaths() {
  const issues = await getIssues();
  return issues.map((issue) => ({ params: { id: issue.id }, props: { issue, issues } }));
}

interface Props { issue: Issue; issues: Issue[] }
const { issue, issues } = Astro.props;
const { data } = issue;
const { Content, headings } = await render(issue);
const sections = headings.filter((h) => h.depth === 2);

const prevIssue = issues.find((i) => i.data.bar === data.bar - 1);
const nextIssue = issues.find((i) => i.data.bar === data.bar + 1);
const nextPlanned = plan.find((p) => p.bar === data.bar + 1);
const tag = data.sample ? ' · sample' : data.status === 'draft' ? ' · draft' : '';
---
<Base title={data.title} description={data.dek}>
  <article>
    <header class="wrap head">
      <div class="score three">
        <div class="stack">
          <a class="backlink" href={url('/#issues')}><span aria-hidden="true">←</span> All issues</a>
          <p class="kicker">No. {data.bar}{tag}</p>
          <h1 class="title">{data.title}</h1>
          <p class="dek">{data.dek}</p>
          <p class="byline">Ryan Abourjeili · <time datetime={data.date.toISOString().slice(0, 10)}>{formatDate(data.date)}</time> · {readingTime(issue)}</p>
        </div>
      </div>
    </header>

    {data.image ? (
      <figure class="wrap fig">
        <div class="score three">
          <div>
            <img src={url(data.image.src)} alt={data.image.alt} />
            <figcaption>{data.image.caption} {data.image.credit}</figcaption>
          </div>
        </div>
      </figure>
    ) : data.imageNeeded && import.meta.env.DEV ? (
      <figure class="wrap fig">
        <div class="score three"><div class="placeholder ph">[Image needed: {data.imageNeeded}]</div></div>
      </figure>
    ) : null}

    <div class="wrap">
      <div class="score three body">
        <div class="prose"><Content /></div>
        {sections.length > 1 && (
          <nav class="side toc" aria-label="In this issue">
            <p class="toc-h">In this issue</p>
            <ol>
              {sections.map((h, n) => (
                <li><a href={`#${h.slug}`} data-slug={h.slug}><span class="toc-n">{n + 1}</span>{h.text}</a></li>
              ))}
              <li><a href="#pg-h" data-slug="pg-h"><span class="toc-n">+</span>Meanwhile, in PianoGlass</a></li>
            </ol>
          </nav>
        )}
      </div>
    </div>
  </article>

  <div class="wrap panel">
    <div class="score three">
      <PianoGlassPanel {...data.pianoglass} />
    </div>
  </div>

  <div class="wrap signup-row">
    <div class="score three">
      <Signup heading="Get the next one by email" />
    </div>
  </div>

  <section class="wrap sources" aria-labelledby="src-h">
    <div class="score three">
      <div class="src">
        <h2 id="src-h">Sources</h2>
        <ol>{data.sources.map((s) => <li set:html={s} />)}</ol>
      </div>
    </div>
  </section>

  <nav class="wrap nextnav" aria-label="More issues">
    <div class="score three">
      <div class="row">
        <div class="pn">
          {prevIssue ? (
            <>
              <span class="label">Previous</span>
              <a href={url(`/issues/${prevIssue.id}/`)}>{prevIssue.data.title}</a>
            </>
          ) : (
            <>
              <span class="label">That's the first one</span>
              <a href={url('/#issues')}>See every issue</a>
            </>
          )}
        </div>
        <div class="pn right">
          {nextIssue ? (
            <>
              <span class="label">Next</span>
              <a href={url(`/issues/${nextIssue.id}/`)}>{nextIssue.data.title}</a>
            </>
          ) : nextPlanned ? (
            <>
              <span class="label">Coming in {nextPlanned.month}</span>
              <span>{nextPlanned.title}</span>
            </>
          ) : null}
        </div>
      </div>
      <p class="all"><a class="backlink" href={url('/#issues')}><span aria-hidden="true">←</span> All issues</a></p>
    </div>
  </nav>
</Base>

<script>
  // Underline the section you're reading in the contents list.
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.toc a[data-slug]'));
  const targets = links
    .map((a) => document.getElementById(a.dataset.slug!))
    .filter((el): el is HTMLElement => !!el);
  if (targets.length) {
    let ticking = false;
    const update = () => {
      ticking = false;
      const line = window.innerHeight * 0.35;
      const current = targets.filter((t) => t.getBoundingClientRect().top < line).at(-1) ?? targets[0];
      links.forEach((a) => a.classList.toggle('active', a.dataset.slug === current.id));
    };
    window.addEventListener('scroll', () => {
      if (!ticking) { ticking = true; requestAnimationFrame(update); }
    }, { passive: true });
    update();
  }
</script>

<style>
  .head { padding-top: 64px; padding-bottom: 40px; }
  .stack { display: flex; flex-direction: column; gap: 20px; }
  .backlink { align-self: flex-start; display: inline-flex; gap: 8px; align-items: center; min-height: 44px; font-size: 17px; text-decoration: none; color: var(--gray); }
  .backlink span { transition: transform 0.2s ease; }
  .backlink:hover { color: var(--ink); }
  .backlink:hover span { transform: translateX(-4px); }
  .stack > .backlink { margin: -14px 0 -6px; }
  .all { margin: 28px 0 0; text-align: center; }
  .fig { padding-bottom: 32px; }
  .fig img { display: block; width: 100%; height: auto; }
  .ph { height: 420px; }

  .body { align-items: start; }
  .toc { position: sticky; top: 32px; align-self: start; padding-top: 52px; }
  .toc-h { margin: 0 0 10px; font-size: 15px; font-style: italic; color: var(--gray); }
  .toc ol { list-style: none; margin: 0; padding: 0; border-left: 1px solid var(--rule); }
  .toc a { display: flex; gap: 10px; padding: 6px 0 6px 14px; margin-left: -1px; border-left: 1px solid transparent; font-size: 15px; line-height: 1.35; color: var(--gray); text-decoration: none; }
  .toc a:hover { color: var(--ink); }
  .toc a.active { color: var(--ink); border-left-color: var(--pencil); }
  .toc-n { font-style: italic; min-width: 0.8em; }

  .panel { padding-top: 64px; padding-bottom: 72px; }
  .signup-row { padding-bottom: 56px; }
  .src { border-top: 1px solid var(--rule); padding-top: 24px; }
  .src h2 { margin: 0 0 14px; font-family: var(--display); font-size: 24px; font-weight: 400; }
  .src ol { margin: 0; padding-left: 22px; display: flex; flex-direction: column; gap: 10px; font-size: 17px; line-height: 1.55; color: var(--ink-2); }
  .nextnav { padding-top: 24px; }
  .row { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; padding-top: 20px; border-top: 1px solid var(--rule); font-size: 19px; line-height: 1.4; }
  .pn { display: flex; flex-direction: column; gap: 4px; }
  .right { text-align: right; }
  .label { font-size: 15px; font-style: italic; color: var(--gray); }
  @media (max-width: 600px) { .row { grid-template-columns: minmax(0, 1fr); } .right { text-align: left; } }
</style>
